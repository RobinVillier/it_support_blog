<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Blog — Robin Villier</title>
  <meta name="description" content="Blog spécialisé IT support de Robin Villier.">
  <link rel="icon" type="image/svg+xml" href="<%= base %>assets/images/logo.svg">
  <%- include('../../partials/theme-init') %>
  <link rel="stylesheet" href="<%= base %>css/style.css">
</head>
<body>
  <%- include('../../partials/header') %>

  <main>
    <section class="container">
      <h2>Blog</h2>
      <p class="lead">Suivez mon parcours dans le monde du support informatique.</p>

      <ul class="post-list">
        <li class="post-list-item">
          <a href="<%= base %>blog/posts/bienvenue-sur-mon-blog.html">
            <div class="post-title">
              <h2>Le début d’un nouveau chapitre 📖</h2>
              <div class="date-icon">
                <span class="icon-mask calendar-icon" aria-hidden="true"></span>
                <span class="post-date">
                  10 Août 2026
                </span>
              </div>
              <p>C’est le départ d’une (quasi) nouvelle aventure. Bienvenue sur mon blog de support informatique.</p>
            </div>
            <img src="<%= base %>assets/images/blogs/welcome-to-my-blog/thumbnail.png" alt="logo as thumbnail for this blog post.">
          </a>
        </li>
      </ul>
    </section>
  </main>

  <%- include('../../partials/contacts') %>
  <%- include('../../partials/footer') %>

  <script src="<%= base %>js/theme.js" defer></script>
  <script src="<%= base %>js/nav.js" defer></script>
  <script src="<%= base %>js/contact.js" defer></script>
</body>
</html>
