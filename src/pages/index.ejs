<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Robin Villier — IT Support Specialist</title>
  <meta name="description" content="Blog spécialisé IT support de Robin Villier.">
  <link rel="icon" type="image/svg+xml" href="<%= base %>assets/images/computer.svg">
  <%- include('../partials/theme-init') %>
  <link rel="stylesheet" href="<%= base %>css/style.css">
</head>
<body>
  <%- include('../partials/header') %>

  <main>
    <section class="container hero">
      <div class="hero-heading">
        <h1>Spécialiste en Support Informatique</h1>
      </div>
      <p class="lead">Rendre la vie plus simple en résolvant des problèmes techiques, un ticket après l'autre.</p>
      <div class="hero-actions">
        <a class="btn btn-accent" href="<%= base %>blog/index.html">Voir mon Blog</a>
        <a class="btn" href="<%= base %>about.html">About Me</a>
      </div>
    </section>

    <section class="container certifications">
      <h2>Certificats</h2>
      <ul class="cert-grid">
        <li class="cert-card">
          <img src="<%= base %>assets/images/google.png" alt="Certification Google IT Support">
          <h3>IT Support Specialist</h3>
          <p class="cert-issuer">Google LLC - 2026</p>
        </li>
        <li class="cert-card">
          <h3>[Certification Name]</h3>
          <p class="cert-issuer">[Issuing Organization] · [Year]</p>
        </li>
        <li class="cert-card">
          <h3>[Certification Name]</h3>
          <p class="cert-issuer">[Issuing Organization] · [Year]</p>
        </li>
      </ul>
    </section>
  </main>

  <%- include('../partials/footer') %>

  <script src="<%= base %>js/theme.js" defer></script>
  <script src="<%= base %>js/nav.js" defer></script>
  <script src="<%= base %>js/contact.js" defer></script>
</body>
</html>
