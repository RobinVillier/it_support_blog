<footer class="site-footer">
  <div class="container">
    <p>&copy; 2026 Robin Villier</p>
    <p class="inner-text">Made with HTML, JavaScript, CSS and EJS. And love ❤️ </p>
    <ul class="contact-links">
      <% contactLinks.forEach(function (link) { %>
      <li>
        <a class="contact-icon-link" href="<%= link.href %>" aria-label="<%= link.label %>"<% if (link.href.indexOf("http") === 0) { %> target="_blank" rel="noopener"<% } %>>
          <span class="icon-mask contact-icon" aria-hidden="true" style="mask-image: url('<%= base %>assets/images/<%= link.icon %>'); -webkit-mask-image: url('<%= base %>assets/images/<%= link.icon %>');"></span>
        </a>
      </li>
      <% }); %>
    </ul>
  </div>
</footer>
