<header class="site-header">
  <div class="container">
    <a class="site-logo" href="<%= base %>index.html">Robin Villier</a>

    <div class="header-controls">
      <button class="theme-toggle" aria-label="Toggle theme">🌙</button>
      <button class="nav-toggle" aria-expanded="false" aria-controls="site-nav" aria-label="Toggle menu">☰</button>
    </div>

    <nav class="site-nav" id="site-nav">
      <ul class="nav-links">
        <% navLinks.forEach(function (link) { %>
      <li><a href="<%= base + link.href %>"<% if (currentPage === link.href) { %> aria-current="page"<% } %>><%= link.label %></a></li>
        <% }); %>
      </ul>
      <ul class="contact-links">
        <% contactLinks.forEach(function (link) { %>
        <li><a class="btn" href="<%= link.href %>"<% if (link.href.indexOf("http") === 0) { %> target="_blank" rel="noopener"<% } %>><%= link.label %></a></li>
        <% }); %>
      </ul>
    </nav>
  </div>
</header>
